{
  "name": "mock4ielts-monorepo",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run web:dev",
    "build": "npm run web:build",
    "start": "npm run web:start",
    "lint": "npm run web:lint",
    "web:dev": "npm --prefix apps/web run dev",
    "web:build": "npm --prefix apps/web run build",
    "web:start": "npm --prefix apps/web run start",
    "web:lint": "npm --prefix apps/web run lint",
    "admin:install": "cd apps/admin && corepack yarn install --frozen-lockfile",
    "admin:dev": "cd apps/admin && corepack yarn dev",
    "admin:build": "cd apps/admin && corepack yarn build",
    "admin:lint": "cd apps/admin && corepack yarn lint",
    "admin:start": "cd apps/admin && corepack yarn start",
    "lint:all": "npm run web:lint && npm run admin:lint",
    "build:all": "npm run web:build && npm run admin:build"
  }
}
